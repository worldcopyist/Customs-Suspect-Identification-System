# Copy to .env for local development. Never commit real keys.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=replace-with-a-random-32-byte-secret
JWT_SIGNING_KEY=replace-with-a-separate-random-32-byte-secret
# Paths below assume startup in the project root. Prefer absolute paths in deployment.
DATABASE_URL=sqlite:///./database/customs_training.db
MEDIA_ROOT=./results
LOGS_ROOT=./backend/logs
MODELS_ROOT=./backend/models
# Optional deployer-reviewed self-contained GLB, not a browser upload.
# AVATAR_ASSET=/absolute/path/to/approved-avatar.glb
# Existing encrypted credentials depend on APP_SECRET_KEY: plan rotation before changing it.
# JWT_SIGNING_KEY is independent. Existing V1.2 browser sessions are revoked by
# the V1.3 authentication migration; do not reuse APP_SECRET_KEY for it.
# LAN deployment requires trusted HTTPS, non-development APP_ENV and exact origins.
# Use an absolute path only when the supplied index.html is located elsewhere.
# FRONTEND_ROOT=/absolute/path/to/frontend
TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
